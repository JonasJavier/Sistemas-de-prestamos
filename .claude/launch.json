{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "backend", "run", "python", "manage.py", "runserver", "127.0.0.1:8800", "--noreload"],
      "port": 8800
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "frontend", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "site", "dev"],
      "port": 4321
    }
  ]
}
