# Copy to .env for local development. Never commit .env.
# Ports match infra/compose.yml (non-standard so they never clash with
# locally installed services).
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://cobradia:cobradia@localhost:54320/cobradia
REDIS_CACHE_URL=redis://localhost:63790/0
CELERY_BROKER_URL=redis://localhost:63790/1
CELERY_RESULT_BACKEND=redis://localhost:63790/2
EMAIL_HOST=localhost
EMAIL_PORT=1025
