# Copy to .env for local development. Never commit .env.
# Ports match infra/compose.yml (non-standard so they never clash with
# locally installed services).
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://cobradia:cobradia@localhost:54320/cobradia
REDIS_CACHE_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1
CELERY_RESULT_BACKEND=redis://localhost:16379/2
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Cobradía <no-responder@cobradia.com>
FRONTEND_URL=http://localhost:5173
# REQUIRE_MFA=true  # decisión 034; apagado en desarrollo para las cuentas de prueba

# Decisión 118: «Continuar con Google» aparece cuando ambas tienen valor (infra/railway/README.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
