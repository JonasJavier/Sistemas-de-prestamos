# Cobradía in production (decision 101). Caddy obtains and renews the TLS
# certificates; the hosts come from the environment (.env of this folder).
# Caddy is the edge: it overwrites any X-Forwarded-For a visitor sends, so
# Django can trust exactly one hop (TRUSTED_PROXY_COUNT=1, decision 102).
{
	email {$ACME_EMAIL}
}

(headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	# The brand images under /marca/ are the exception: other sites (Gmail) show them.
	@not_brand not path /marca/*
	header @not_brand Cross-Origin-Resource-Policy "same-origin"
}

# The app: the SPA, its API and the static files of Django.
{$APP_HOST} {
	import headers
	encode zstd gzip
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	request_body {
		max_size 25MB
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle /assets/* {
		root * /srv/app
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/app
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# The promotion site: nothing loads from elsewhere, so it is cross-origin isolated.
{$SITE_HOST} {
	import headers
	header Cross-Origin-Embedder-Policy "require-corp"
	encode zstd gzip
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	# The brand images (email signature, profile photo) are shown by other sites, like Gmail.
	header /marca/* Cross-Origin-Resource-Policy "cross-origin"
	root * /srv/site
	file_server
	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server
		}
	}
}

www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}
