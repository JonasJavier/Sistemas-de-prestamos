# Copy to .env (never commit it) and fill every value. Generate secrets with:
#   openssl rand -hex 32
APP_VERSION=v1.0.0
APP_HOST=app.cobradia.com
SITE_HOST=cobradia.com
ACME_EMAIL=

DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Mail provider (SMTP with TLS)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=Cobradía <no-responder@cobradia.com>

# WhatsApp and SMS (decision 097): «registro» until Twilio is contracted
MESSAGING_WHATSAPP_PROVIDER=registro
MESSAGING_SMS_PROVIDER=registro
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_WHATSAPP=
TWILIO_FROM_SMS=

# Errors (doc 10 - 3)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Backups (backup.sh): the PUBLIC gpg key that encrypts them (the private one
# stays offline) and the rclone remote outside the server
BACKUP_PUBLIC_KEY=/opt/cobradia/backup-public.asc
BACKUP_DIR=/var/backups/cobradia
BACKUP_REMOTE=
