# Cobradía on Railway (decision 113). Railway's edge terminates TLS and
# always forwards https; Caddy listens on $PORT in plain HTTP and keeps the
# headers, the SPA, the site and the proxy to the API of the VPS Caddyfile.
# The edge writes the visitor's address in X-Real-IP (a client cannot set
# it), so Caddy hands Django exactly one trusted hop (TRUSTED_PROXY_COUNT=1).
{
	admin off
	auto_https off
}

(headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
}

:{$PORT:8080} {
	import headers
	encode zstd gzip

	# The promotion site: nothing loads from elsewhere, so it is cross-origin isolated.
	@www host www.{$SITE_HOST:cobradia.com}
	redir @www https://{$SITE_HOST:cobradia.com}{uri} permanent

	@site host {$SITE_HOST:cobradia.com}
	handle @site {
		header Cross-Origin-Embedder-Policy "require-corp"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		root * /srv/site
		file_server
	}
	handle_errors {
		@missing {
			host {$SITE_HOST:cobradia.com}
			expression {err.status_code} == 404
		}
		handle @missing {
			root * /srv/site
			rewrite * /404.html
			file_server
		}
	}

	# Every other host is the app: the SPA and its API.
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		request_body {
			max_size 25MB
		}

		handle /api/* {
			reverse_proxy {$API_UPSTREAM:api.railway.internal:8000} {
				header_up X-Forwarded-For {http.request.header.X-Real-IP}
				header_up X-Forwarded-Proto https
			}
		}
		handle /assets/* {
			root * /srv/app
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			root * /srv/app
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
