---
/** The mark of the favicon and the wordmark, as in the app: «Cobradía»
 * with its golden í. */
interface Props {
  tone?: 'default' | 'light'
}
const { tone = 'default' } = Astro.props
---

<span class:list={['brand', { 'brand-light': tone === 'light' }]}>
  <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="16" class:list={['brand-mark-box', { light: tone === 'light' }]}
    ></rect>
    <path
      d="M42.5 22.5a13 13 0 1 0 0 19"
      fill="none"
      stroke="#fff"
      stroke-width="7"
      stroke-linecap="round"></path>
    <circle cx="45" cy="15" r="4.5" fill="#c9a227"></circle>
  </svg>
  <span>Cobrad<span class="brand-i">í</span>a</span>
</span>
