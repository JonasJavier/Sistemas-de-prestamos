---
import Base from './Base.astro'
import { LEGAL_UPDATED } from '../config'

/** Terms and privacy: one readable column (decisions 103 and 127). */
interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
---

<Base title={`${title} · Cobradía`} description={description}>
  <article class="wrap legal">
    <h1>{title}</h1>
    <p class="legal-date">Versión del {LEGAL_UPDATED}</p>
    <slot />
  </article>
</Base>
