---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { CONTACT_EMAIL, SIGN_UP, TRIAL_DAYS } from '../config'
import { PLANS, FAQ } from '../landing-content'

const title = 'Cobradía · Tu financiera, en su mejor día'
const description = `Préstamos, cobros y caja en un solo lugar. El sistema para financieras dominicanas que quieren trabajar con más control. Prueba gratis ${TRIAL_DAYS} días, sin tarjeta.`
const views = [
  {
    id: 'inicio',
    label: 'Tu panorama',
    icon: 'chart',
    caption:
      'Lo cobrado, lo pendiente y lo que necesita tu atención. Todo a primera vista.',
    alt: 'Inicio real del gerente: cobros del día, solicitudes y cierres por aprobar',
  },
  {
    id: 'prestamos',
    label: 'Préstamos',
    icon: 'loan',
    caption:
      'Cada préstamo, su estado y su próxima cuota. Una cartera que puedes seguir.',
    alt: 'Lista real de préstamos con estados, cuotas y atrasos',
  },
  {
    id: 'caja',
    label: 'Cobros y caja',
    icon: 'wallet',
    caption: 'Del cobro al cierre de caja, cada movimiento tiene su lugar.',
    alt: 'Pantalla real de caja con cobros, saldo esperado y arqueo',
  },
  {
    id: 'atrasos',
    label: 'Seguimiento',
    icon: 'clock',
    caption:
      'Detecta los atrasos y prioriza las gestiones que tu cartera necesita.',
    alt: 'Pantalla real de atrasos agrupados por antigüedad y capital en riesgo',
  },
]
const steps = [
  {
    title: 'Presta con claridad.',
    icon: 'loan',
    text: 'Del cliente al desembolso. Evalúa solicitudes, configura tus tasas y genera el calendario de pagos.',
    detail: 'Clientes · Solicitudes · Préstamos',
  },
  {
    title: 'Cobra con orden.',
    icon: 'wallet',
    text: 'Registra pagos, emite recibos y cierra cada caja con el detalle de lo que entró y lo que salió.',
    detail: 'Cobros · Recibos · Caja',
  },
  {
    title: 'Decide con información.',
    icon: 'chart',
    text: 'Consulta tu cartera, sigue los atrasos y encuentra lo que necesita atención antes de cerrar el día.',
    detail: 'Reportes · Cobranza · Contabilidad',
  },
]
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cobradía',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://cobradia.com/',
  description,
  inLanguage: 'es-DO',
  areaServed: 'DO',
}
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-copy">
      <a class="hero-badge" href="#pantallas">
        <span class="status-dot"></span> El nuevo día de tu financiera{' '}
        <Icon name="arrow" />
      </a>
      <h1 id="hero-title">
        Menos pendientes.
        <br />
        <span>Más tranquilidad.</span>
        <svg
          class="sun-mark"
          viewBox="0 0 80 80"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="40" cy="40" r="12" />
          <path d="M40 3v15m0 44v15M3 40h15m44 0h15M14 14l11 11m30 30 11 11M14 66l11-11m30-30 11-11" />
        </svg>
      </h1>
      <p class="hero-lead">
        Tu cartera, tus cobros y tu equipo. Por fin, en el mismo lugar.
        <br class="desktop-break" /> El sistema que le da claridad al día de tu
        financiera.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={SIGN_UP}>
          Empieza tus {TRIAL_DAYS} días gratis <Icon name="arrow" />
        </a>
        <a class="btn btn-secondary" href="#pantallas">
          <Icon name="play" /> Conoce Cobradía
        </a>
      </div>
      <p class="hero-note">
        <Icon name="check" /> Sin tarjeta <span>·</span> Sin instalaciones{' '}
        <span>·</span> Hecho para RD
      </p>
    </div>
    <div class="wrap product-wrap" id="pantallas">
      <div class="product-stage">
        <div class="stage-label">
          <span class="status-dot"></span> TODO EN SU LUGAR{' '}
          <span class="stage-number">01 — 04</span>
        </div>
        <div class="product-window">
          <div class="window-bar">
            <div class="window-dots" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </div>
            <span>
              <Icon name="lock" /> app.cobradia.com
            </span>
            <span class="window-demo">Vista de demostración</span>
          </div>
          <div class="product-views">
            {views.map((view, index) => (
              <figure
                id={`panel-${view.id}`}
                aria-labelledby={`tab-${view.id}`}
                data-product-panel
                hidden={index !== 0}
                tabindex="0"
              >
                <img
                  src={`/capturas/${view.id}.png`}
                  width="1280"
                  height="800"
                  alt={view.alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                />
                <figcaption>{view.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
        <div class="product-seal" aria-hidden="true">
          <span>
            <Icon name="check" />
          </span>
          <div>
            Un día más claro.<small>Una financiera bajo control.</small>
          </div>
        </div>
      </div>
      <div class="product-tabs" aria-label="Explora las pantallas de Cobradía">
        {views.map((view, index) => (
          <button
            id={`tab-${view.id}`}
            type="button"
            data-product-tab
            aria-controls={`panel-${view.id}`}
            aria-pressed={index === 0}
          >
            <Icon name={view.icon} />
            {view.label}
          </button>
        ))}
      </div>
      <p class="demo-note">
        Capturas reales de Cobradía con datos de demostración.
      </p>
    </div>
  </section>

  <section class="local-strip wrap" aria-label="Hecho para tu operación">
    <p>
      Nacido aquí.
      <br />
      <strong>Pensado para tu financiera.</strong>
    </p>
    <span>
      <Icon name="globe" /> Pesos dominicanos
    </span>
    <span>
      <Icon name="people" /> Cada persona, su rol
    </span>
    <span>
      <Icon name="shield" /> Tus datos, protegidos
    </span>
  </section>

  <section class="section workflow" id="funciones">
    <div class="wrap">
      <div class="section-heading reveal">
        <div>
          <span class="eyebrow">MENOS FRICCIÓN. MÁS DIRECCIÓN.</span>
          <h2>
            Todo conectado.
            <br />
            <span>Nada en el aire.</span>
          </h2>
        </div>
        <p>
          Tu operación no debería vivir entre hojas de cálculo, mensajes y
          libretas. Dale a cada parte de tu negocio un lugar para trabajar
          mejor.
        </p>
      </div>
      <div class="workflow-grid">
        {steps.map((step, index) => (
          <article class="workflow-item reveal">
            <div class="workflow-top">
              <span class="feature-icon">
                <Icon name={step.icon} />
              </span>
              <span class="step-number">0{index + 1}</span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <span class="feature-detail">{step.detail}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="field-section" aria-labelledby="field-title">
    <div class="wrap field-grid">
      <div class="field-copy reveal">
        <span class="eyebrow">DE LA OFICINA A LA CALLE</span>
        <h2 id="field-title">
          Tu equipo se mueve.
          <br />
          <span>El control va contigo.</span>
        </h2>
        <p>
          La ruta del día en el celular del cobrador. El avance de la operación
          en manos del supervisor. Todos trabajando sobre la misma información.
        </p>
        <ul class="checks">
          <li>Rutas y clientes asignados a cada cobrador.</li>
          <li>Cobros, recibos y promesas de pago en el lugar.</li>
          <li>Seguimiento de gestiones desde la oficina.</li>
        </ul>
        <a class="text-link" href="/ayuda/cobrador/">
          Conoce el día de un cobrador <Icon name="arrow" />
        </a>
        <small class="field-note">
          Disponible desde el plan Profesional. Requiere internet.
        </small>
      </div>
      <div class="phone-scene reveal">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <span class="scene-label">
          CERCA DE TUS CLIENTES.
          <br />
          AL DÍA CON TU EQUIPO.
        </span>
        <div class="phone-frame">
          <div class="phone-camera" aria-hidden="true"></div>
          <img
            src="/capturas/ruta.png"
            width="390"
            height="844"
            loading="lazy"
            alt="Ruta real del cobrador en el celular, con clientes y acciones para llamar, escribir y cobrar"
          />
        </div>
        <div class="route-note">
          <span class="feature-icon">
            <Icon name="route" />
          </span>
          <div>
            Tu próxima parada.<small>Todo listo para seguir.</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section start-section" id="como-funciona">
    <div class="wrap start-grid">
      <div class="reveal">
        <span class="eyebrow">UN NUEVO COMIENZO, SIN COMPLICACIONES</span>
        <h2>
          Menos vueltas.
          <br />
          Más avance.
        </h2>
        <p class="section-intro">
          Empieza con tu financiera como es hoy.
          <br />
          Cobradía te acompaña en lo que sigue.
        </p>
        <a class="text-link" href={SIGN_UP}>
          Dale orden a tu día <Icon name="arrow" />
        </a>
      </div>
      <ol class="onboarding">
        <li class="reveal">
          <span>01</span>
          <div>
            <h3>Crea tu cuenta</h3>
            <p>
              Registra tu empresa y empieza tu prueba gratis de {TRIAL_DAYS}{' '}
              días.
            </p>
          </div>
        </li>
        <li class="reveal">
          <span>02</span>
          <div>
            <h3>Hazlo tuyo</h3>
            <p>
              Configura productos, sucursales y equipo. Si ya tienes cartera,
              importa tus clientes y préstamos con nuestras plantillas.
            </p>
          </div>
        </li>
        <li class="reveal">
          <span>03</span>
          <div>
            <h3>Empieza tu nuevo día</h3>
            <p>
              Desembolsa, cobra y sigue tu operación desde la computadora o el
              celular.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="security-section">
    <div class="wrap security-inner">
      <div class="security-heading reveal">
        <Icon name="shield" />
        <h2>
          La confianza también
          <br />
          está en los detalles.
        </h2>
      </div>
      <div class="security-item reveal">
        <Icon name="lock" />
        <h3>Un espacio para tu empresa</h3>
        <p>
          Datos aislados y verificación en dos pasos para proteger cada acceso.
        </p>
      </div>
      <div class="security-item reveal">
        <Icon name="people" />
        <h3>Cada acción, en su lugar</h3>
        <p>Permisos por rol y auditoría para saber quién hizo qué y cuándo.</p>
      </div>
    </div>
  </section>

  <section class="section pricing-section" id="precios">
    <div class="wrap">
      <div class="section-head centered reveal">
        <span class="eyebrow">UN PLAN PARA TU PRÓXIMA ETAPA</span>
        <h2>Crece a tu ritmo.</h2>
        <p>Clientes y préstamos sin límite. Elige cómo quieres trabajar.</p>
      </div>
      <div
        class="billing-toggle"
        role="group"
        aria-label="Período de facturación"
      >
        <button type="button" data-billing="monthly" aria-pressed="true">
          Mensual
        </button>
        <button type="button" data-billing="annual" aria-pressed="false">
          Anual <span>2 meses gratis</span>
        </button>
      </div>
      <div class="plans">
        {PLANS.map((plan) => (
          <article
            class:list={['plan', 'reveal', { 'plan-featured': plan.featured }]}
          >
            <div class="plan-heading">
              <h3>{plan.name}</h3>
              {plan.featured && (
                <span class="plan-tag">Para dar el siguiente paso</span>
              )}
            </div>
            <p class="plan-pitch">{plan.pitch}</p>
            <div class="price-figure">
              <span class="currency">RD$</span>{' '}
              <span
                data-price
                data-monthly={plan.price}
                data-annual={plan.price * 10}
              >
                {plan.price.toLocaleString('es-DO')}
              </span>
              <small data-price-period>/ mes</small>
            </div>
            <p
              class="plan-billing"
              data-price-description
              data-monthly-copy={`O RD$ ${(plan.price * 10).toLocaleString('es-DO')} al año · 2 meses gratis`}
              data-annual-copy="Pago anual completo · usas 12 meses y pagas 10"
            >
              O RD$ {(plan.price * 10).toLocaleString('es-DO')} al año · 2 meses
              gratis
            </p>
            <a
              class:list={[
                'btn',
                plan.featured ? 'btn-light' : 'btn-secondary',
              ]}
              href={SIGN_UP}
            >
              Empezar gratis <Icon name="arrow" />
            </a>
            <p class="plan-size">{plan.size}</p>
            <ul class="checks">
              {plan.bullets.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="plans-note">
        Precios de lanzamiento, sin ITBIS. Todos los planes incluyen{' '}
        {TRIAL_DAYS} días de prueba gratis.
        <br />
        Pago por transferencia o depósito.{' '}
        <a href={`mailto:${CONTACT_EMAIL}`}>
          Te ayudamos a activar tu suscripción.
        </a>
      </p>
      <p class="sr-only" data-billing-status aria-live="polite"></p>
    </div>
  </section>

  <section class="section faq-section" id="preguntas">
    <div class="wrap faq-grid">
      <div class="reveal">
        <span class="eyebrow">HABLEMOS CLARO</span>
        <h2>
          Es bueno
          <br />
          tener respuestas.
        </h2>
        <p class="section-intro">
          Si te queda alguna duda,
          <br />
          <a href={`mailto:${CONTACT_EMAIL}`}>estamos a un mensaje.</a>
        </p>
      </div>
      <div class="faq">
        {FAQ.map((item) => (
          <details name="faq">
            <summary>
              {item.q}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-section">
    <div class="wrap closing reveal">
      <span class="eyebrow">EMPIEZA UNA NUEVA FORMA DE TRABAJAR</span>
      <h2>
        Tu próximo gran paso.
        <br />
        <span>Un día más tranquilo.</span>
      </h2>
      <p>Más claridad para tu financiera. Más tiempo para lo que sigue.</p>
      <a class="btn btn-primary" href={SIGN_UP}>
        Prueba Cobradía gratis <Icon name="arrow" />
      </a>
      <small>
        {TRIAL_DAYS} días para conocerlo. Sin tarjeta. Sin compromiso.
      </small>
      <div class="closing-line" aria-hidden="true"></div>
    </div>
  </section>
  <script src="../scripts/landing.ts"></script>
</Base>
